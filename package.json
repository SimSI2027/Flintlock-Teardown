{
  "name": "flintlock-teardown",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 3D teardown simulator of a U.S. Model 1805 (Harpers Ferry) flintlock pistol. Historical visual study only; non-functional.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "timeline": "node scripts/timeline.mjs",
    "test": "node --test tests/unit/*.test.mjs && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "video": "node scripts/video.mjs",
    "site": "node scripts/site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.1"
  }
}
